# Copia este archivo a .env y ajusta los valores según tu entorno local.

# Cadena de conexión a PostgreSQL: postgresql://usuario:password@host:puerto/basededatos?schema=public
DATABASE_URL="postgresql://sgi_app:cambia_esta_password@localhost:5432/sgi_dev?schema=public"

# Secreto usado para firmar los JWT (usa un valor largo y aleatorio en producción)
JWT_SECRET="cambia_este_secreto_en_produccion"

# Tiempo de expiración del JWT de acceso (vida corta a propósito: la sesión
# prolongada la sostiene el refresh token, ver REFRESH_TOKEN_TTL_DIAS)
JWT_EXPIRES_IN="22m"

# Vida útil del refresh token en días (rotación en cada uso)
REFRESH_TOKEN_TTL_DIAS=7

# Puerto en el que escucha el servidor Express
PORT=3000

# Entorno de ejecución: development | test | production
NODE_ENV=development

# SMTP opcional para el envío real de correo de notificaciones (alertas).
# Si SMTP_HOST queda vacío, el sistema sigue funcionando: solo se registra la
# notificación interna y se omite el correo (no se simula un envío exitoso).
# Ejemplo con Mailtrap/Gmail con contraseña de aplicación:
# SMTP_HOST="smtp.mailtrap.io"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="usuario"
# SMTP_PASS="password"
# SMTP_FROM="SGI <no-reply@tiansiecuador.com>"
