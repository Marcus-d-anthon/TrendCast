// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────
// ENUMS
// ──────────────────────────────

// BODEGA reemplaza al antiguo OPERADOR (migracion de datos, no de nombre
// solamente: ver migrations/*_erp_expansion/migration.sql). VENTAS y
// GERENCIA son roles nuevos.
enum RolUsuario {
  ADMIN
  SUPERVISOR
  BODEGA
  VENTAS
  GERENCIA
}

enum TipoMovimiento {
  ENTRADA
  SALIDA
  AJUSTE
  TRANSFERENCIA
}

enum AccionAuditoria {
  CREATE
  UPDATE
  SOFT_DELETE
  LOGIN
}

enum TipoDocumento {
  CEDULA
  RUC
  PASAPORTE
}

enum EstadoDocumentoComercial {
  BORRADOR
  CONFIRMADA
  ANULADA
}

enum TipoAlerta {
  STOCK_BAJO
  AGOTADO
  POR_VENCER
  COMPRA_PENDIENTE
  VENTA_ANULADA
}

enum CanalNotificacion {
  SISTEMA
  EMAIL
}

// ──────────────────────────────
// EMPRESA
// Preparacion para multi-tenant: el esquema ya segmenta por empresa_id en
// las tablas de negocio, pero el sistema opera hoy con una sola empresa
// sembrada (TIANSHI). No existe todavia flujo de alta de nuevas empresas ni
// aislamiento de datos activo -- ver docs/tesis para el detalle de alcance.
// ──────────────────────────────

model Empresa {
  id             String  @id @default(uuid())
  ruc            String  @unique
  razonSocial    String  @map("razon_social")
  nombreComercial String? @map("nombre_comercial")
  activo         Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  usuarios   Usuario[]
  marcas     Marca[]
  unidades   UnidadMedida[]
  almacenes  Almacen[]
  categorias Categoria[]
  productos  Producto[]
  clientes   Cliente[]
  proveedores Proveedor[]
  compras    Compra[]
  ventas     Venta[]
  alertas    Alerta[]

  @@map("empresas")
}

// ──────────────────────────────
// USUARIOS
// ──────────────────────────────

model Usuario {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String     @map("password_hash")
  nombre       String
  rol          RolUsuario @default(BODEGA)
  activo       Boolean    @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by") // FK logica -> usuarios.id (agregada a mano en la migracion)
  updatedBy String?   @map("updated_by") // FK logica -> usuarios.id
  deletedAt DateTime? @map("deleted_at")

  movimientosRegistrados MovimientoInventario[] @relation("MovimientoRegistradoPor")
  refreshTokens          RefreshToken[]
  notificaciones         Notificacion[]
  comprasRegistradas     Compra[]                @relation("CompraRegistradaPor")
  ventasRegistradas      Venta[]                 @relation("VentaRegistradaPor")

  @@index([rol])
  @@index([deletedAt])
  @@index([empresaId])
  @@map("usuarios")
}

// ──────────────────────────────
// PERMISOS (rol -> permiso, independiente de la logica de negocio)
// ──────────────────────────────

model Permiso {
  id          String  @id @default(uuid())
  codigo      String  @unique // ej. "inventario.crear"
  modulo      String
  accion      String
  descripcion String?

  roles RolPermiso[]

  @@map("permisos")
}

model RolPermiso {
  id        String     @id @default(uuid())
  rol       RolUsuario
  permisoId String     @map("permiso_id")
  permiso   Permiso    @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@unique([rol, permisoId])
  @@map("roles_permisos")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@map("refresh_tokens")
}

// ──────────────────────────────
// CATALOGOS (Marca, UnidadMedida, Categoria, Almacen)
// Mismo patron de soft delete que el resto del sistema.
// ──────────────────────────────

model Marca {
  id     String  @id @default(uuid())
  nombre String
  activo Boolean @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([deletedAt])
  @@map("marcas")
}

model UnidadMedida {
  id          String  @id @default(uuid())
  nombre      String
  abreviatura String
  activo      Boolean @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([deletedAt])
  @@map("unidades_medida")
}

model Categoria {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  productos Producto[]

  @@unique([empresaId, nombre])
  @@index([deletedAt])
  @@map("categorias")
}

model Almacen {
  id        String  @id @default(uuid())
  nombre    String
  direccion String?
  activo    Boolean @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  stocks              Stock[]
  lotes                Lote[]
  movimientos          MovimientoInventario[]
  compras              Compra[]
  ventas               Venta[]

  @@unique([empresaId, nombre])
  @@index([deletedAt])
  @@map("almacenes")
}

// ──────────────────────────────
// PRODUCTOS
// ──────────────────────────────

model Producto {
  id            String  @id @default(uuid())
  sku           String  @unique
  nombre        String
  descripcion   String?
  precioCompra  Decimal @map("precio_compra") @db.Decimal(10, 2)
  precioVenta   Decimal @map("precio_venta") @db.Decimal(10, 2)
  stockMinimo   Int     @default(0) @map("stock_minimo")
  requiereLote  Boolean @default(false) @map("requiere_lote")
  activo        Boolean @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  categoriaId String    @map("categoria_id")
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)

  marcaId String @map("marca_id")
  marca   Marca  @relation(fields: [marcaId], references: [id], onDelete: Restrict)

  unidadMedidaId String       @map("unidad_medida_id")
  unidadMedida   UnidadMedida @relation(fields: [unidadMedidaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  stocks           Stock[]
  lotes            Lote[]
  movimientos      MovimientoInventario[]
  detallesCompra   DetalleCompra[]
  detallesVenta    DetalleVenta[]

  @@index([categoriaId])
  @@index([marcaId])
  @@index([unidadMedidaId])
  @@index([deletedAt])
  @@index([activo])
  @@index([empresaId])
  // No agrupado, compuesto: cubre "ORDER BY nombre" del listado paginado y
  // el filtro por categoria+nombre a la vez sin tener que ordenar en memoria.
  @@index([empresaId, nombre])
  @@map("productos")
}

// ──────────────────────────────
// STOCK (saldo por producto Y ALMACEN — reemplaza a la antigua StockActual,
// que asumia un unico saldo global por producto)
// ──────────────────────────────

model Stock {
  id       String @id @default(uuid())
  cantidad Int    @default(0)

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  almacenId String  @map("almacen_id")
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@unique([productoId, almacenId])
  @@map("stock")
}

// ──────────────────────────────
// LOTES (solo para productos con requiere_lote = true)
// ──────────────────────────────

model Lote {
  id               String   @id @default(uuid())
  numeroLote       String   @map("numero_lote")
  fechaVencimiento DateTime @map("fecha_vencimiento")
  cantidad         Int      @default(0)

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  almacenId String  @map("almacen_id")
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  @@unique([productoId, almacenId, numeroLote])
  @@index([fechaVencimiento])
  @@map("lotes")
}

// ──────────────────────────────
// TERCEROS (Cliente, Proveedor)
// ──────────────────────────────

model Cliente {
  id              String        @id @default(uuid())
  tipoDocumento   TipoDocumento @map("tipo_documento")
  numeroDocumento String        @map("numero_documento")
  nombre          String
  email           String?
  telefono        String?
  direccion       String?
  activo          Boolean       @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  ventas Venta[]

  @@unique([empresaId, numeroDocumento])
  @@index([deletedAt])
  @@index([empresaId, nombre])
  @@map("clientes")
}

model Proveedor {
  id               String        @id @default(uuid())
  tipoDocumento    TipoDocumento @map("tipo_documento")
  numeroDocumento  String        @map("numero_documento")
  razonSocial      String        @map("razon_social")
  nombreComercial  String?       @map("nombre_comercial")
  email            String?
  telefono         String?
  direccion        String?
  activo           Boolean       @default(true)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")
  deletedAt DateTime? @map("deleted_at")

  compras Compra[]

  @@unique([empresaId, numeroDocumento])
  @@index([deletedAt])
  @@index([empresaId, razonSocial])
  @@map("proveedores")
}

// ──────────────────────────────
// COMPRAS
// Cabecera + detalle. BORRADOR es editable/eliminable; una vez CONFIRMADA
// genera movimientos de inventario y pasa a ser inmutable salvo el cambio de
// estado a ANULADA (que no revierte movimientos automaticamente: una compra
// anulada tras confirmarse requiere un AJUSTE manual, igual que cualquier
// otra correccion del libro de movimientos).
// ──────────────────────────────

model Compra {
  id       String                   @id @default(uuid())
  numero   String                   @unique
  fecha    DateTime                 @default(now())
  estado   EstadoDocumentoComercial @default(BORRADOR)
  subtotal Decimal                  @default(0) @db.Decimal(12, 2)
  impuesto Decimal                  @default(0) @db.Decimal(12, 2)
  total    Decimal                  @default(0) @db.Decimal(12, 2)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  proveedorId String    @map("proveedor_id")
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id], onDelete: Restrict)

  almacenId String  @map("almacen_id")
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: Restrict)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("CompraRegistradaPor", fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  detalle     DetalleCompra[]
  movimientos MovimientoInventario[]

  @@index([proveedorId])
  @@index([estado])
  @@index([empresaId])
  @@map("compras")
}

model DetalleCompra {
  id             String  @id @default(uuid())
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  compraId String @map("compra_id")
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([compraId])
  @@map("detalle_compras")
}

// ──────────────────────────────
// VENTAS (mismo patron que Compras, con movimientos SALIDA)
// ──────────────────────────────

model Venta {
  id       String                   @id @default(uuid())
  numero   String                   @unique
  fecha    DateTime                 @default(now())
  estado   EstadoDocumentoComercial @default(BORRADOR)
  subtotal Decimal                  @default(0) @db.Decimal(12, 2)
  impuesto Decimal                  @default(0) @db.Decimal(12, 2)
  total    Decimal                  @default(0) @db.Decimal(12, 2)

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  clienteId String  @map("cliente_id")
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  almacenId String  @map("almacen_id")
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: Restrict)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("VentaRegistradaPor", fields: [usuarioId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  detalle     DetalleVenta[]
  movimientos MovimientoInventario[]

  @@index([clienteId])
  @@index([estado])
  @@index([empresaId])
  @@map("ventas")
}

model DetalleVenta {
  id             String  @id @default(uuid())
  cantidad       Int
  precioUnitario Decimal @map("precio_unitario") @db.Decimal(10, 2)
  subtotal       Decimal @db.Decimal(12, 2)

  ventaId String @map("venta_id")
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@index([ventaId])
  @@map("detalle_ventas")
}

// ──────────────────────────────
// MOVIMIENTOS DE INVENTARIO
// Libro inmutable, append-only. Nunca se edita ni se borra: una correccion
// se registra como un nuevo movimiento de tipo AJUSTE que referencia, via
// auto-relacion, al movimiento original. Por eso NO tiene updated_at,
// updated_by ni deleted_at (no aplican conceptualmente a una fila que nunca
// muta). Ver extensions/immutable-ledger.extension.ts para el bloqueo tecnico.
// Cada movimiento queda atado a un almacen concreto (multi-almacen); una
// TRANSFERENCIA genera dos filas (SALIDA en origen, ENTRADA en destino)
// enlazadas por movimiento_origen_id, igual mecanismo que un AJUSTE.
// ──────────────────────────────

model MovimientoInventario {
  id              String         @id @default(uuid())
  tipo            TipoMovimiento
  cantidad        Int
  saldoResultante Int            @map("saldo_resultante")
  referencia      String?
  motivo          String?

  productoId String   @map("producto_id")
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  almacenId String  @map("almacen_id")
  almacen   Almacen @relation(fields: [almacenId], references: [id], onDelete: Restrict)

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation("MovimientoRegistradoPor", fields: [usuarioId], references: [id], onDelete: Restrict)

  movimientoOrigenId String?                @map("movimiento_origen_id")
  movimientoOrigen   MovimientoInventario?  @relation("AjusteDeMovimiento", fields: [movimientoOrigenId], references: [id], onDelete: Restrict)
  ajustes            MovimientoInventario[] @relation("AjusteDeMovimiento")

  compraId String? @map("compra_id")
  compra   Compra? @relation(fields: [compraId], references: [id], onDelete: Restrict)

  ventaId String? @map("venta_id")
  venta   Venta?  @relation(fields: [ventaId], references: [id], onDelete: Restrict)

  fecha     DateTime @default(now()) // fecha de negocio del movimiento
  createdAt DateTime @default(now()) @map("created_at") // marca de sistema

  @@index([productoId, fecha])
  @@index([almacenId])
  @@index([fecha])
  @@index([tipo])
  @@index([movimientoOrigenId])
  @@index([compraId])
  @@index([ventaId])
  @@map("movimientos_inventario")
}

// ──────────────────────────────
// ALERTAS
// Antes se calculaban al vuelo (solo stock bajo/agotado); ahora se
// persisten para poder marcarse como resueltas y disparar notificaciones,
// y para cubrir tipos que requieren estado (POR_VENCER, COMPRA_PENDIENTE,
// VENTA_ANULADA).
// ──────────────────────────────

model Alerta {
  id         String     @id @default(uuid())
  tipo       TipoAlerta
  entidad    String
  registroId String     @map("registro_id")
  mensaje    String
  resuelta   Boolean    @default(false)
  fecha      DateTime   @default(now())
  resueltaEn DateTime?  @map("resuelta_en")

  empresaId String  @map("empresa_id")
  empresa   Empresa @relation(fields: [empresaId], references: [id], onDelete: Restrict)

  @@index([tipo, resuelta])
  @@index([entidad, registroId])
  @@index([empresaId])
  @@map("alertas")
}

model Notificacion {
  id      String            @id @default(uuid())
  titulo  String
  mensaje String
  canal   CanalNotificacion @default(SISTEMA)
  leida   Boolean           @default(false)
  fecha   DateTime          @default(now())

  usuarioId String  @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, leida])
  @@map("notificaciones")
}

// ──────────────────────────────
// AUDIT LOG generico
// ──────────────────────────────

model AuditLog {
  id            String          @id @default(uuid())
  entidad       String
  registroId    String          @map("registro_id")
  accion        AccionAuditoria
  valorAnterior Json?           @map("valor_anterior")
  valorNuevo    Json?           @map("valor_nuevo")
  usuarioId     String?         @map("usuario_id") // FK logica -> usuarios.id
  ip            String?
  userAgent     String?         @map("user_agent")
  fecha         DateTime        @default(now())

  @@index([entidad, registroId])
  @@index([fecha])
  @@index([usuarioId])
  @@map("audit_log")
}
